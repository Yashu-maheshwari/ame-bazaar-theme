# Path to the Docker Desktop executable
DOCKER_DESKTOP_PATH=C:\Program Files\Docker\Docker\Docker Desktop.exe

# Command/Executable to start n8n natively (e.g. npx n8n, or path to node wrapper)
N8N_EXECUTABLE=npx n8n

# Native port for n8n
N8N_PORT=5678

# Absolute path to the local Windows cloudflared.exe executable
CLOUDFLARED_PATH=C:\tools\cloudflared.exe
